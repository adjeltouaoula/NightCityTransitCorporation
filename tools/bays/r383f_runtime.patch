+  // r383e generic bay assets use the same validated H2-local spline shape but
+  // are addressed per authored stop.
+  private func NCTCBayArrivalSplinePath() -> String {
+    if Equals(this.requestedStopId, 20) { return "$/nctc/bays/stop_20/arrival_spline"; };
+    if Equals(this.requestedStopId, 69) { return "$/nctc/bays/stop_69/arrival_spline"; };
+    if Equals(this.requestedStopId, 70) { return "$/nctc/bays/stop_70/arrival_spline"; };
+    return "";
+  }
